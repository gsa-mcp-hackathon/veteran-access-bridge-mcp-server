# SYNTHETIC DEMO ONLY. These are TanStack Start SERVER variables.
# Never add VITE_ or NEXT_PUBLIC_ to secrets.
# Restricted reviewer entry (Code Engine): a separate shared reviewer code,
# never the operator code or backend key. Enable only with fixed HTTPS origin.
VAB_REVIEWER_LOGIN_ENABLED=false
VAB_REVIEWER_ACCESS_CODE=
# Current hosted Call in Browser uses the separate opt-in guest settings below;
# see docs/deployment/current-sandbox.md. Defaults here remain disabled.
# Local/operator mode: loopback backend or HTTPS Code Engine with the existing
# 32+ character operator code. Historical Lovable hosting used this mode.
# Never enable the local one-click mode on a public preview.
VAB_MSA_LIVE_MONITOR_ENABLED=false
VAB_API_BASE_URL=http://127.0.0.1:8080
# Private one-click demo (no typed operator code). Honoured ONLY with the monitor
# gate above, a loopback VAB_API_BASE_URL, and requests whose Host/Origin are
# localhost or this Codespace's private *.app.github.dev forwarding host.
# Keep the forwarded port PRIVATE. Never enable on hosted Lovable/IBM.
VAB_MSA_ONE_CLICK_DEMO_ENABLED=false

# Set these only in an ignored local .env or secret manager when actively testing.
# Each value must be a DISTINCT strong random string of at least 32 characters.
# Backend and frontend use the SAME monitor service key; do not commit it.
VAB_MSA_MONITOR_SERVICE_KEY=
VAB_MSA_OPERATOR_ACCESS_CODE=

# Opt-in CLI smoke test (not required for normal app startup):
# VAB_RUN_MSA_MONITOR_SMOKE=1
# VAB_MSA_FRONTEND_URL=http://127.0.0.1:5173
# VAB_MSA_TEST_CASE_ID=DEMO-PC-5000999-001
# VAB_MSA_TEST_VOICE_SESSION_ID=<active-synthetic-session-id>

# HOSTED LOVABLE CONNECTION (example only; keep values server-side):
# VAB_API_BASE_URL=https://veteran-access-bridge-m64-canary.2fmg3lakuuzb.ca-tor.codeengine.appdomain.cloud
# VAB_MSA_LIVE_MONITOR_ENABLED=true
# VAB_MSA_ONE_CLICK_DEMO_ENABLED=false
# VAB_MSA_MONITOR_SERVICE_KEY=<same-private-key-as-deployed-backend>
# VAB_MSA_OPERATOR_ACCESS_CODE=<different-private-random-32+-character-code>
# The browser asks for the demo access code once, never for a Case/Voice Session ID.
# The server retains the backend service key; it must not appear in browser code.
# The deployed VAB must contain matching API routes and working LiveKit settings.
# The event observer additionally requires VAB_MSA_MONITOR_ENABLED on the backend.
# A published call center needs verified operator authentication before real-data use.

# OPTIONAL IBM embedded-agent mode (separate from trusted LiveKit acceptance).
# Defaults remain disabled. Configure only server-side, with existing secrets.
VAB_PUBLIC_AVERY_EMBED_ENABLED=false
VAB_PUBLIC_AVERY_EMBED_ORIGIN=
VAB_EMBED_TOKEN_SERVICE_KEY=
VAB_EMBED_GUEST_COOKIE_KEY=

# Separate guest call/activity modes. These flags do not authorize a public launch.
VAB_PUBLIC_GUEST_CALL_ENABLED=false
VAB_PUBLIC_GUEST_ORIGIN=
VAB_PUBLIC_GUEST_ACTIVITY_ENABLED=false
VAB_CALL_ACTIVITY_SERVICE_KEY=

# Backend/worker signing keys, database credentials and VAB_VOICE_WORKER_SECRET
# do NOT belong in this frontend environment. See docs/deployment/current-sandbox.md.
# Build-time only for IBM: VAB_DEPLOY_TARGET=code-engine, NITRO_PRESET=node-server.
