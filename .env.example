# LOCAL SYNTHETIC DEMO ONLY - NEVER PUT REAL VA CREDENTIALS HERE
VAB_ENV=local_synthetic
VAB_DATA_MODE=synthetic
VAB_LOG_LEVEL=INFO
APP_ENV=local_synthetic

# MSA application/runtime projection
# Comma-separated browser origins when CORS is enforced by the deployment edge.
MSA_UI_ALLOWED_ORIGINS=
EVENT_STREAM_HEARTBEAT_SECONDS=15
EVENT_STREAM_IDLE_TIMEOUT_SECONDS=300
# Optional deployment metadata. IBM Code Engine may provide revision metadata.
CODE_ENGINE_APPLICATION=
CODE_ENGINE_REVISION=
# Only set when the application backend directly needs the remote MCP URL.
REMOTE_MCP_URL=

# MCP transport selection
# VAB_MCP_TRANSPORT=stdio              (default — local development)
# VAB_MCP_TRANSPORT=streamable-http    (remote — requires VAB_MCP_API_KEY)
VAB_MCP_TRANSPORT=stdio

# Remote MCP service-authentication key (demo/hackathon control only).
# Required when VAB_MCP_TRANSPORT=streamable-http.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
# Supply via environment variable or IBM Code Engine secret — NEVER commit a real value.
# This is NOT production VA identity or session authentication.
VAB_MCP_API_KEY=

# Trusted host identity for private synthetic Primary Care services.
# Configure only after an approved issuer exists. The host assertion must be
# independently signed with RS256 and include exact scope and case_ids claims.
VAB_TRUSTED_HOST_ISSUER=
VAB_TRUSTED_HOST_AUDIENCE=
VAB_TRUSTED_HOST_SUBJECT=
VAB_TRUSTED_HOST_PUBLIC_KEY_PATH=
# Keep the HS256 grant key in a protected secret manager, never in source.
VAB_PRIVATE_VA_BOOKING_SIGNING_SECRET=

# Optional Phoenix evaluation harness.
# Supply these only in your local .env; never commit real keys.
USAI_API_KEY=
USAI_BASE_URL=
AGENT_MODEL=
JUDGE_MODEL=


# watsonx Orchestrate server-side runtime (Issues #79 / #82)
# fake = local/offline development; remote = IBM runtime.
# Keep real values in local secrets / IBM Code Engine secrets only.
ORCHESTRATE_RUNTIME_MODE=fake
ORCHESTRATE_BASE_URL=
# Runtime UUID for the deployed veteran_access_agent in the current IBM environment.
ORCHESTRATE_AGENT_ID=89801bbc-fa87-41f9-b9d7-d2a9b4cbf0c3
# Preferred durable server-side auth. Store the real value only in a secret.
ORCHESTRATE_API_KEY=
# Temporary compatibility path only; prefer ORCHESTRATE_API_KEY.
ORCHESTRATE_BEARER_TOKEN=
ORCHESTRATE_CHAT_PATH=/v2/orchestrate/{agent_id}/chat/completions
ORCHESTRATE_IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token
ORCHESTRATE_TOKEN_REFRESH_SKEW_SECONDS=300
ORCHESTRATE_THREAD_HEADER=X-IBM-THREAD-ID
ORCHESTRATE_TIMEOUT_SECONDS=30
ORCHESTRATE_MAX_RETRIES=1

# Secure embedded chat. Keep the private key server-side only.
# Preferred: base64-encoded PEM to avoid multiline secret handling issues.
ORCHESTRATE_EMBED_PRIVATE_KEY_B64=
# Optional raw PEM alternative. Never expose either value to browser JavaScript.
ORCHESTRATE_EMBED_PRIVATE_KEY=
ORCHESTRATE_EMBED_TOKEN_TTL_SECONDS=3600


# IBM Phone integration (Phase 3)
# Secret configured in the IBM log webhook and supplied to this app only as a
# server-side secret. Used to verify IBM's signed CDR log-webhook JWT.
# Never expose this value to browser JavaScript or commit a real value.
IBM_PHONE_LOG_WEBHOOK_SECRET=


# Headless Avery phone/SIP transport
# VAB never renders the IBM embedded agent UI.
# Set these only after the IBM Phone channel has actually been configured.
# IBM_PHONE_PROVIDER examples for this prototype: SIP or GENESYS.
IBM_PHONE_PROVIDER=UNCONFIGURED
IBM_PHONE_CHANNEL_CONFIGURED=false

# Optional browser/WebRTC voice transport.
# Keep the softphone disabled until a real media gateway and signaling endpoint
# are configured. The first recommended open-source adapter is self-hosted
# LiveKit; IBM Phone/Genesys remains an optional separate transport.
VAB_WEBRTC_GATEWAY=UNCONFIGURED
VAB_WEBRTC_GATEWAY_CONFIGURED=false
VAB_WEBRTC_SIGNALING_URL=
VAB_WEBRTC_TOKEN_TTL_SECONDS=300
VAB_WEBRTC_SOFTPHONE_ENABLED=false

# LiveKit Cloud connection and credentials are server-side only.
# LIVEKIT_URL must be the project's wss://...livekit.cloud URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram real-time voice pipeline. Alexis is currently exposed by Deepgram
# as the Flux TTS model flux-alexis-en.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=flux-alexis-en
# Flux turn detection. Start conservative/stable; tune from measured call traces.
DEEPGRAM_EOT_THRESHOLD=0.7
DEEPGRAM_EOT_TIMEOUT_MS=3000
# Deepgram recommends 80 ms audio chunks for Flux.
DEEPGRAM_AUDIO_CHUNK_MS=80

# Avery LiveKit worker -> existing VAB FastAPI runtime.
VAB_VOICE_BACKEND_URL=http://127.0.0.1:8080
VAB_VOICE_BACKEND_TIMEOUT_SECONDS=35

# Optional protected synthetic browser booking. Keep disabled without the full
# trusted-host configuration described in docs/plans/browser-booking-acceptance.md.
# These belong only on the backend; no browser-supplied case or model grant.
VAB_ENABLE_TRUSTED_VOICE_BOOKING=false
VAB_ENABLE_BROWSER_PC_BOOKING=false
VAB_PRIVATE_PC_APPROVED_CASE=

# Private browser-only test SSN last-four check, in addition to name and DOB.
# Requires the trusted dynamic caller resolver and agent scheduling configuration.
# Keep off until frontend and voice worker both support vab.private-identity RPC.
# Never collect these digits in spoken dialogue or store them in transcripts.
VAB_REQUIRE_MASKED_LAST_FOUR=false
# Spoken collection instead of a browser field; deploy to backend AND worker.
# Still requires VAB_REQUIRE_MASKED_LAST_FOUR=true for strict source matching.
# Worker masks verification hypotheses before SDK history/caption publication.
VAB_SPOKEN_LAST_FOUR=false

# Existing VA Facilities sandbox key; server only. This read does not establish
# a patient's assigned clinic and does not enable appointment writes.
VA_FACILITIES_READ_ENABLED=false
VA_FACILITIES_API_KEY=
## Explicit demo clinic -> VA Facilities ID association; never patient assignment.
## Leave empty until the named demo destination is verified and selected.
VAB_DEMO_CLINIC_FACILITIES=
